DJANGO_SECRET_KEY=replace-with-a-secure-secret-key
DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Local development database. Production settings require DATABASE_URL and
# should use a persistent deployment database.
DATABASE_URL=sqlite:///db.sqlite3

# PostgreSQL format example (replace every deployment-specific value):
# DATABASE_URL=postgresql://postgres:your-password@localhost:5432/bloodconnect

SECURE_HSTS_SECONDS=31536000

# Interactive address lookup. Set an application contact URL or email in the User-Agent.
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=BloodConnect/1.0 (contact: your-project-contact@example.org)
